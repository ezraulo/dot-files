// GOEXPERIMENT=goroutineleakprofile go run main.go\
func main() {\
	// Start pprof HTTP server\
	go func() {\
		http.ListenAndServe("localhost:6060", nil)\
	}()\
	fmt.Println("http://localhost:6060/debug/pprof/")\
\
	// Create 10 goroutine leaks\
	for i := 0; i < 10; i++ {\
		ch := make(chan int)\
		go func(id int) {\
			fmt.Printf("Goroutine %d started\n", id)\
			<-ch // This goroutine will block forever, causing a leak\
		}(i)\
	}\
\
	// Wait longer to ensure leak detection\
	time.Sleep(5 * time.Second)\
	fmt.Println("Number of Goroutines:", runtime.NumGoroutine())\
\
	// Wait even longer to trigger leak profiler\
	fmt.Println("Waiting for leak detection...")\
	time.Sleep(10 * time.Second)\
	fmt.Println("Check the link, leaks should be detected")\
\
	// Keep server running so you can check pprof endpoint\
	select {}\
}\

